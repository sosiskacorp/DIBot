{
  "ollama": {
    "base_url": "http://localhost:11434",
    "models_dir": "D:\\OllamaModels",
    "request_timeout": 600,
    "keep_alive": "30m",
    "model_cache_ttl": 30
  },

  "models": {
    "qwen3.5:9b": {
      "role": "general",
      "num_ctx": 4096,
      "max_ctx": 262144,
      "note": "Быстрый универсал. Конспекты, объяснения, роль критика."
    },
    "deepseek-r1:8b": {
      "role": "reasoning",
      "num_ctx": 4096,
      "max_ctx": 131072,
