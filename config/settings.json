      "model": "qwen3.5:9b",
      "fallback": ["qwen2.5-coder:7b", "deepseek-r1:8b"],
      "temperature": 0.7,
      "think": false
    },
    "notes": {
      "model": "qwen3.5:9b",
      "fallback": ["qwen3-vl:8b", "qwen2.5-coder:7b"],
      "temperature": 0.35,
      "think": true
    },
    "summary": {
      "model": "qwen3.5:9b",
      "fallback": ["qwen2.5-coder:7b"],
      "temperature": 0.2,
      "think": false
    },
    "math": {
      "model": "deepseek-r1:8b",
      "fallback": ["qwen3.5:9b", "qwen2.5-coder:7b"],
      "temperature": 0.15,
      "think": true
    },
    "code": {
      "model": "qwen2.5-coder:7b",
      "fallback": ["qwen3.5:9b"],
      "temperature": 0.1,
      "think": false
    },
    "latex": {
      "model": "qwen2.5-coder:7b",
      "fallback": ["qwen3.5:9b"],
      "temperature": 0.1,
      "think": false
    },
    "vision": {
      "model": "qwen3-vl:8b",
      "fallback": ["qwen3.5:9b"],
      "temperature": 0.2,
      "think": false
    },
    "verify": {
      "model": "qwen3.5:9b",
      "fallback": ["deepseek-r1:8b", "qwen2.5-coder:7b"],
